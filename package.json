{
  "name": "npc-generator",
  "version": "2.0.0",
  "description": "Generator of randomized Non-Player Characters (NPCs) with attributes, in-depth and unique descriptions as well as a plot hook",
  "keywords": [
    "generator",
    "npc"
  ],
  "homepage": "https://www.npcgenerator.com",
  "license": "MIT",
  "contributors": [
    {
      "name": "Michael Ferris"
    },
    {
      "name": "Étienne Ponton-Bouchard"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Cellule/npc-generator.git"
  },
  "files": [
    "CHANGELOG.md",
    "dist"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "prepublishOnly": "npm run build && npm test",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen": "node scripts/gen.js",
    "clean": "rimraf dist .cache",
    "build": "npm run gen && npm run clean && tsc --build",
    "lint": "oxlint src --deny-warnings --report-unused-disable-directives",
    "lint:fix": "oxlint src --fix --fix-suggestions",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "rimraf": "^6.1.4",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=26.0.0",
    "npm": ">=11.0.0"
  }
}
